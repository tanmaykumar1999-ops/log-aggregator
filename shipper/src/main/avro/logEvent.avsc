{
  "type": "record",
  "name": "LogEvent",
  "namespace": "dev.tanmay.logagg.model",
  "doc": "One log line shipped from a service host.",
  "fields": [
    { "name": "service",   "type": "string", "doc": "Logical service name; also used as the Kafka record key." },
    { "name": "host",      "type": "string" },
    { "name": "timestamp", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "level",     "type": "string" },
    { "name": "message",   "type": "string" },
    { "name": "trace_id",  "type": ["null", "string"], "default": null },
    { "name": "raw",       "type": "string", "doc": "The original line, untouched." }
  ]
}